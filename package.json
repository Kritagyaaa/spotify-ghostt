{
  "name": "echord",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "frontend": "vite",
    "backend": "nodemon backend/server.js",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "vite build",
    "build:mobile": "vite build --base=/",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@capacitor/core": "^8.4.1",
    "@react-oauth/google": "^0.13.5",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "latest",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.2",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.10"
  }
}
